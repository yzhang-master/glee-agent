# Copy to .env and fill in. NEVER commit .env.

# GLEE competition agent keys (from https://glee-competition.com/dashboard)
GLEE_API_KEY_MAIN=glee_...
# Optional extra agents for A/B testing (create in dashboard, max 5 per account)
GLEE_API_KEY_TEST_A=
GLEE_API_KEY_TEST_B=

# LLM gateway (OpenAI-compatible) for message generation / opponent-text parsing
LLM_API_BASE=https://yunwu.ai/v1
LLM_API_KEY=sk-...
LLM_MODEL=deepseek-chat

# Feature flags (per-run overrides; see src/glee_agent/config.py)
GLEE_AGENT_LLM_ENABLED=1
GLEE_AGENT_CONCURRENCY=8
